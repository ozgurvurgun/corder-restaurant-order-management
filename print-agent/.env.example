BACKEND_WS_URL=https://api.corders.uk
BACKEND_SOCKET_PATH=/ws
BACKEND_ORDER_EVENT_NAME=order:created
AGENT_TOKEN=replace-with-static-print-agent-token
AGENT_ID=windows-pos-1
RESTAURANT_ID=demo-restaurant

# printer_mode: network_raw | command
PRINTER_MODE=command
PRINTER_NAME=REPLACE_WITH_WINDOWS_PRINTER_NAME
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100
PRINT_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File ".\\scripts\\send-raw-printer.ps1" -PrinterName "{PRINTER_NAME}" -FilePath "{FILE}"
# On first print, scripts\\RawPrinterHelper.dll is created (Add-Type cache); if slow/broken, delete it and run again. Bump helperAssemblyVersion in the script when the C# source changes.

# Category (UUID) -> printer: get the id from the panel (click category → URL/API) or from the DB. JSON on one line.
# With PRINTER_MODE=command, values must match the Windows "Printer name".
# Management panel (cash) check receipt — full list on one printer. Terminal check: receiptMode=split + PRINT_CATEGORY_ROUTES.
# MANAGEMENT_RECEIPT_PRINTER=KASA_FIS
# PRINT_CATEGORY_ROUTES={"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee":"MUTFAK","11111111-2222-3333-4444-555555555555":"BAR YAZICI"}
# Network printers (network_raw): host:port per category
# PRINT_CATEGORY_NETWORK={"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee":"192.168.1.10:9100"}
# BACKEND_HTTP_URL=https://api.example.com

# Optional first line (centered) to verify the Windows agent runs this codebase (e.g. v0.2.0)
# PRINT_TICKET_STAMP=v0.2.0
# Last line on the ticket (centered), e.g. branch / trade name
# PRINT_FOOTER_LINE= Mekan
# TICKET_CHARS_PER_LINE=42
# Feed lines before cut (ESC d n); escpos also adds 2 LFs. Default 6.
# TICKET_FEED_LINES_BEFORE_CUT=6
# After Node: extra wait (ms). USB+Winspool: default 600. If the ticket still needs unplug, try 900–1200 or use Ethernet + PRINTER_MODE=network_raw.
# PRINT_USB_DRAIN_MS=600

RECONNECT_MS=3000
PING_INTERVAL_MS=15000
# Optional: queue retry polling interval (ms). Lower = faster retries after failures.
# QUEUE_DRAIN_MS=500
