{
  "name": "corder-print-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Corder Desktop Print Agent & Control Center (Linux, Windows, macOS)",
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron --no-sandbox electron/main.js",
    "electron": "electron --no-sandbox electron/main.js",
