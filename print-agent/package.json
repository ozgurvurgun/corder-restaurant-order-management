    "mock:server": "node src/mock-ws-server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^41.7.1"
  }
}
