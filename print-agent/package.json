{
  "name": "corder-print-agent",
  "version": "0.3.0",
  "private": true,
  "description": "Corder Desktop Print Agent & Local Web Control Center",
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
