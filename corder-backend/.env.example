# Copy: cp .env.example .env
# Development template — rotate all secrets in production (openssl rand -hex 32).

NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=corder
DB_PASSWORD=corder_secret
DB_NAME=corder
DB_SYNCHRONIZE=false
# DB_POOL_MAX=20
# DB_SSL=false

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=12h
PLATFORM_JWT_SECRET=CHANGE_ME_PLATFORM_JWT_SECRET

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_ADMIN_PASSWORD
PLATFORM_ADMIN_AUTH_CODE=CHANGE_ME_PLATFORM_ADMIN_AUTH_CODE

# Production / reverse proxy (optional)
# TRUST_PROXY=true
# BODY_LIMIT=1mb
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# SKIP_MIGRATIONS_ON_START=true

# Cloudflare R2 (if all set, uploads go to R2; otherwise local ./uploads)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://cdn.example.com
