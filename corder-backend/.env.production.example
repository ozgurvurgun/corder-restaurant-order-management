# Server — copy to .env; MUST replace sample secrets with ones you generate.
# openssl rand -hex 32

NODE_ENV=production
PORT=4000

DB_HOST=db
DB_PORT=5432
DB_USERNAME=corder
DB_PASSWORD=STRONG_DATABASE_PASSWORD
DB_NAME=corder
DB_POOL_MAX=20
DB_SSL=false

JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d
PLATFORM_JWT_SECRET=CHANGE_ME_PLATFORM_JWT_SECRET

PLATFORM_ADMIN_EMAIL=admin@corder.app
PLATFORM_ADMIN_PASSWORD=STRONG_PLATFORM_ADMIN_PASSWORD

TRUST_PROXY=true
BODY_LIMIT=1mb
CORS_ORIGIN=https://admin.corders.uk,https://merchant.corders.uk,https://terminal.corders.uk,https://menu.corders.uk,https://boss.corders.uk,https://corder-admin-frontend.pages.dev,https://corder-terminal-frontend.pages.dev,https://corder-panel-frontend.pages.dev,https://corder-menu-frontend.pages.dev,https://corder-boss-frontend.pages.dev

# SKIP_MIGRATIONS_ON_START=false

# Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=corder-uploads
# R2_PUBLIC_BASE_URL=https://media.corders.uk
