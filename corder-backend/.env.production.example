# Server — copy to .env; MUST replace the sample secrets below with ones you generate.
# openssl rand -hex 32

NODE_ENV=production
PORT=4000

DB_HOST=db
DB_PORT=5432
DB_USERNAME=corder
DB_PASSWORD=STRONG_DATABASE_PASSWORD
DB_NAME=corder

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d
PLATFORM_JWT_SECRET=CHANGE_ME_PLATFORM_JWT_SECRET

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=STRONG_PLATFORM_ADMIN_PASSWORD

TRUST_PROXY=true
# CORS_ORIGIN=https://panel.example.com,https://terminal.example.com,https://menu.example.com,https://admin.example.com

# SKIP_MIGRATIONS_ON_START=

# Cloudflare R2 — panel/menu images (S3-compatible; public URL custom domain or r2.dev)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://cdn.example.com
